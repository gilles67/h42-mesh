! Generated by h42-mesh-agent: do not edit, changes are overwritten.
frr defaults traditional
log syslog informational
service integrated-vtysh-config
!
{% if model.uses(groups.active) %}
bfd
 profile h42-active
  detect-multiplier {{ bfd_multiplier }}
  receive-interval {{ bfd_interval }}
  transmit-interval {{ bfd_interval }}
 exit
 !
exit
!
{% endif %}
ip prefix-list H42-EXCLUDED-V4 seq 5 permit 169.254.0.0/16 le 32
ip prefix-list H42-EXCLUDED-V4 seq 10 permit 127.0.0.0/8 le 32
!
ipv6 prefix-list H42-EXCLUDED-V6 seq 5 permit fe80::/10 le 128
ipv6 prefix-list H42-EXCLUDED-V6 seq 10 permit ::1/128
!
bgp large-community-list expanded H42-BACKUP-ROUTES permit {{ backup_regex }}
!
! Networks of the default VRF, without tunnels, loopback and containers.
route-map H42-CONNECTED deny 10
 match ip address prefix-list H42-EXCLUDED-V4
exit
!
route-map H42-CONNECTED deny 20
 match ipv6 address prefix-list H42-EXCLUDED-V6
exit
!
{% for name in model.excluded_interfaces %}
route-map H42-CONNECTED deny {{ 100 + loop.index0 }}
 match interface {{ name }}
exit
!
{% endfor %}
route-map H42-CONNECTED permit 65000
exit
!
! Any route that went through a backup tunnel somewhere: low preference.
route-map H42-IN permit 10
 match large-community H42-BACKUP-ROUTES
 set local-preference {{ backup_local_pref }}
exit
!
route-map H42-IN permit 20
exit
!
{% if model.uses(groups.backup) %}
! Received on a backup tunnel: marked, and low preference.
route-map H42-IN-BACKUP permit 10
 set large-community {{ model.asn }}:1:2 additive
 set local-preference {{ backup_local_pref }}
exit
!
{% endif %}
route-map H42-OUT permit 10
exit
!
router bgp {{ model.asn }}
 no bgp default ipv4-unicast
 bgp log-neighbor-changes
{% if model.uses(groups.active) %}
 neighbor {{ groups.active }} peer-group
 neighbor {{ groups.active }} capability extended-nexthop
 neighbor {{ groups.active }} bfd profile h42-active
{% endif %}
{% if model.uses(groups.backup) %}
 neighbor {{ groups.backup }} peer-group
 neighbor {{ groups.backup }} capability extended-nexthop
 neighbor {{ groups.backup }} timers {{ backup_timers[0] }} {{ backup_timers[1] }}
{% endif %}
{% if model.uses(groups.internal) %}
 neighbor {{ groups.internal }} peer-group
 neighbor {{ groups.internal }} remote-as internal
 neighbor {{ groups.internal }} capability extended-nexthop
{% endif %}
{% for n in model.neighbors %}
{% if n.remote_as is not none %}
 neighbor {{ n.address }} remote-as {{ n.remote_as }}
{% endif %}
 neighbor {{ n.address }} peer-group {{ n.group }}
 neighbor {{ n.address }} interface {{ n.interface }}
 neighbor {{ n.address }} description {{ n.description }}
{% endfor %}
 !
{% for family in ("ipv4", "ipv6") %}
 address-family {{ family }} unicast
  redistribute connected route-map H42-CONNECTED
{% if model.uses(groups.active) %}
  neighbor {{ groups.active }} activate
  neighbor {{ groups.active }} send-community large
  neighbor {{ groups.active }} route-map H42-IN in
  neighbor {{ groups.active }} route-map H42-OUT out
{% endif %}
{% if model.uses(groups.backup) %}
  neighbor {{ groups.backup }} activate
  neighbor {{ groups.backup }} send-community large
  neighbor {{ groups.backup }} route-map H42-IN-BACKUP in
  neighbor {{ groups.backup }} route-map H42-OUT out
{% endif %}
{% if model.uses(groups.internal) %}
  neighbor {{ groups.internal }} activate
  neighbor {{ groups.internal }} next-hop-self
  neighbor {{ groups.internal }} send-community large
  neighbor {{ groups.internal }} route-map H42-IN in
{% endif %}
 exit-address-family
 !
{% endfor %}
exit
!
