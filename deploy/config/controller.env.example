# Settings of the controller container (h42-mesh-controller.container).
# Copy to ~/.config/h42-mesh/controller.env and adapt. No secret here: the
# passphrase is the Podman secret h42-mesh-passphrase.
# Database, passphrase and GeoLite2 paths are set by the Quadlet unit.

# Traefik runs on the host network and connects from the loopback: it is the
# only proxy allowed to pass the client address (X-Forwarded-For).
H42_MESH_TRUSTED_PROXIES=["127.0.0.1/32","::1/128"]

# Expected "aud" of the agent JWTs (same value in the agents' configuration).
H42_MESH_AGENT_JWT_AUDIENCE=h42-mesh-controller

# Optional (defaults shown):
# H42_MESH_SESSION_LIFETIME_MINUTES=720
# H42_MESH_SESSION_IDLE_MINUTES=30
# H42_MESH_ENROLLMENT_TOKEN_HOURS=4
