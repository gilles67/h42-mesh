# h42-mesh controller image.
#
# Build from the repository root, with controller/ as the context:
#   podman build -t localhost/h42-mesh-controller:latest \
#       -f deploy/controller/Containerfile controller/
#
# No secret is ever copied into the image: the passphrase is a Podman secret,
# the SQLite database and the GeoLite2 database are volumes.

FROM docker.io/library/python:3.13-slim-trixie AS build

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /src
# Dependencies first: this layer is reused while only the code changes.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable


FROM docker.io/library/python:3.13-slim-trixie

RUN useradd --system --uid 10001 --user-group --home-dir /nonexistent \
        --shell /usr/sbin/nologin h42mesh \
    && mkdir /data /geoip \
    && chown h42mesh:h42mesh /data

COPY --from=build /opt/venv /opt/venv

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    H42_MESH_DATABASE_URL=sqlite:///data/h42-mesh.db

USER 10001
WORKDIR /data

# Loopback only: Traefik, on the host network, is the single entry point.
# --no-proxy-headers: X-Forwarded-For is handled by the controller itself,
# only from H42_MESH_TRUSTED_PROXIES.
CMD ["uvicorn", "h42mesh.controller.app:create_app", "--factory", \
     "--host", "127.0.0.1", "--port", "8000", \
     "--no-proxy-headers", "--no-server-header"]
